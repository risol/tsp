ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG BUN_VERSION=1.3.14
ARG RUST_TOOLCHAIN=nightly-2026-07-20

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_TERM_COLOR=always \
    RUSTUP_TOOLCHAIN=${RUST_TOOLCHAIN} \
    PATH=/opt/bun:/root/.cargo/bin:/usr/lib/llvm-21/bin:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        file \
        git \
        gnupg \
        lsb-release \
        unzip \
        wget \
        build-essential \
        cmake \
        ninja-build \
        nasm \
        pkg-config \
        python3 \
    && rm -rf /var/lib/apt/lists/*

# Keep the compiler toolchain aligned with the Linux GitHub Actions runner.
RUN wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key \
    | tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc >/dev/null \
    && . /etc/os-release \
    && echo "deb http://apt.llvm.org/${VERSION_CODENAME}/ llvm-toolchain-${VERSION_CODENAME}-21 main" \
       > /etc/apt/sources.list.d/llvm.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends clang-21 lld-21 llvm-21 \
    && rm -rf /var/lib/apt/lists/*

# Install the bootstrap Bun version used by the repository workflows.
RUN mkdir -p /opt/bun \
    && curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip" \
       -o /tmp/bun.zip \
    && unzip -q /tmp/bun.zip -d /tmp/bun \
    && cp /tmp/bun/bun-linux-x64/bun /opt/bun/bun \
    && chmod +x /opt/bun/bun \
    && rm -rf /tmp/bun /tmp/bun.zip

# Install the pinned nightly toolchain used by the repository workflows.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain none \
    && rustup toolchain install "${RUSTUP_TOOLCHAIN}" --profile minimal --no-self-update

WORKDIR /src

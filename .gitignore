# Local runtime and package output
dist/
public/*
!public/.gitkeep
.logs/
.logs-*.txt
.docker_build_info

# Local configuration and secrets
.env
.env.*
!.env.example

# Bun/Rust build output is also ignored by bun/.gitignore.
bun/build/
bun/target/
native/target/
native/fixtures/build/
.tsp-build-native-check/
.tsp-build/
bun/vendor/
bun/node_modules/
.bun-bootstrap/
node_modules/

# Local test artifacts
test_*.xlsx
test-uploads/
uploads/
output/
*.tmp
.cache/
.claude/settings.local.json

# bench output (smoke benchmark JSON)
bench-*.json

# one-off debug logs from manual `Start-Process` runs of the
# production binary (e.g. when reproducing a master crash). Not
# committed; the canonical capture is `tsp.sh dev` / `tsp.sh test`.
.frag-*.log

# Generated by `./tsp.sh typings` (or `tspserver_v2 typings`).
# The user adds the directory to their `tsconfig.json` `include`
# list; it does not need to be in the repo. Override with
# `TSP_TYPINGS_DIR` or `--out <DIR>`.
.tsp-types/

# One-off Python / PowerShell scratch files used to repair
# PowerShell-Set-Content-induced UTF-8 corruption (CJK comments
# in src/ files). Safe to delete; never committed.
.fix.py
.diag.py
fix_services.py

# One-off bun smoke scripts used to verify how bun
# handles `//# sourceURL=` and `//# sourceMappingURL=`
# for file-loaded scripts. Safe to delete.
.bun-smoke.ts
.smoke.ts

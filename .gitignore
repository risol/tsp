dist/
public/*
!public/.gitkeep
.logs/
.logs-*.txt
.docker_build_info

# Local configuration and secrets
.env
.env.*
!.env.example

# Bun/Rust build output is also ignored by bun/.gitignore.
bun/build/
bun/target/
bun/vendor/
bun/node_modules/
.bun-bootstrap/
node_modules/


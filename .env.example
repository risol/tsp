# TSP native host configuration
TSP_PORT=9000
TSP_ROUTES_DIR=./routes
TSP_PUBLIC_DIR=./public
TSP_EMBEDDED_WORKER=1
TSP_WORKER_BIN=./bun/build/release/bun
TSP_WORKER_COUNT=2

# Optional worker lifecycle limits
# TSP_WORKER_MAX_REQUESTS=10000
# TSP_WORKER_MAX_AGE_MS=3600000
# TSP_WORKER_MAX_MEMORY_BYTES=536870912

# Optional Redis-backed session storage
# TSP_REDIS_URL=redis://127.0.0.1:6379

# Optional request limits
# TSP_MAX_BODY_BYTES=10485760
# TSP_TIMEOUT_MS=30000

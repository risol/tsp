{
  "name": "tsp",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts --dev",
    "start": "bun run src/main.ts",
    "build": "bun build src/main.ts --compile --outfile tspserver",
    "test": "bun test tests/unit",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun run tests/run_e2e_tests.ts",
    "test:all": "bun run tests/run_all_tests.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "compressing": "^1.10.1",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "jsonc-parser": "^3.3.1",
    "ldapts": "^5.0.0",
    "mysql2": "^2.3.3",
    "nanoid": "^5.0.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redis": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "bun-types": "latest",
    "typescript": "^5.7.0"
  }
}
